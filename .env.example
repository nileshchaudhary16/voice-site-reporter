# ── Gemini API (Google AI Studio) ─────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq API (Speech-to-Text via Whisper) ─────────────────────
# Get from: https://console.groq.com → API Keys → Create key
# Free tier: 7,200 seconds of audio/day. No cold start. Works in India.
GROQ_API_KEY=your_groq_api_key_here

# ── Google Sheets ──────────────────────────────────────────────
# Name of the Google Sheet you created and shared with service account
GOOGLE_SHEET_NAME=SiteReports

# ── WhatsApp (Meta Cloud API — FREE, 1,000 conversations/month) ─
# Get from: https://developers.facebook.com → your app → WhatsApp → API Setup
META_ACCESS_TOKEN=your_meta_access_token
META_PHONE_NUMBER_ID=your_phone_number_id
# You choose this value yourself — enter the same string in Meta's webhook setup
META_VERIFY_TOKEN=site-reporter-verify

# ── Daily Summary Email ────────────────────────────────────────
# Gmail address you send FROM (enable 2FA, then create an App Password)
SENDER_EMAIL=yourname@gmail.com
# Gmail App Password (NOT your real password): https://myaccount.google.com/apppasswords
SENDER_APP_PASSWORD=your_gmail_app_password
# Manager's email to receive the daily summary
MANAGER_EMAIL=manager@example.com
# Manager's WhatsApp for anomaly alerts — country code, NO + and NO spaces (Meta format)
MANAGER_WHATSAPP=919876543210
